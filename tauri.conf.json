{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Startup Launcher",
  "version": "0.1.0",
  "identifier": "com.tsiens.startuplauncher",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Startup Launcher",
        "width": 1000,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "assets/app.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
